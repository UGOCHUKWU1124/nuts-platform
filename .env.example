# ==============================================================================
# NUTS Commerce — Root Environment Example
# ==============================================================================
# Copy to .env at the repository root (next to docker-compose.yml).
#
# This file only contains compose-level configuration (ports, build args).
# All secrets (DB, JWT, SMTP, etc.) belong in server/.env and client/.env.
# ==============================================================================

# ── Port Mapping ──────────────────────────────────────────────────────────────
# Host ports for dev profile (mapped to container internal ports)
API_PORT=3001
CLIENT_PORT=5173

# ── Build-time Variables (Production only) ────────────────────────────────────
# Public origin used by notifications/SSE and CSP. With the Docker Nginx stack,
# this is the same HTTPS host as PUBLIC_DOMAIN. With Vercel, use the API's HTTPS
# origin here; the browser API path remains same-origin through the Next rewrite.
PUBLIC_DOMAIN=shop.example.com
NEXT_PUBLIC_BACKEND_URL=https://shop.example.com
NEXT_PUBLIC_API_URL=/api/v1
# Server-side Next.js API origin. In the all-in-one Docker stack this is the
# internal Compose alias. On Vercel, set this to the deployed API HTTPS origin.
INTERNAL_API_URL=http://api:3001

# ── Optional Overrides ───────────────────────────────────────────────────────
# NODE_ENV=development
# SWAGGER_ENABLED=true
