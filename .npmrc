# Enforce Node.js engine requirements
engine-strict=true

# Use the root package-lock.json
package-lock=true

# Allow normal semver ranges in package.json
save-exact=false

# Network resilience for CI runners against transient registry socket drops / ECONNRESET
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=300000