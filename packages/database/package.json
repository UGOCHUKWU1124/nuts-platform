{
  "name": "@nuts/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "prisma generate --schema=./schema.prisma",
    "db:push": "prisma db push --schema=./schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./schema.prisma"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.4.0",
    "@prisma/client": "^6.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "prisma": "^6.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "prisma": {
    "schema": "schema.prisma"
  }
}
