# ==============================================================================
# NUTS Commerce — Server Environment Example
# ==============================================================================
# Copy to .env and fill in real values. Never commit secrets.

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001

# ─── CORS & Cookies ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# In production set to your root domain, e.g. .nuts-commerce.com (with leading dot)
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# ─── Account Lifecycle ────────────────────────────────────────────────────────
ACCOUNT_DELETION_GRACE_DAYS=60

# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Transaction-mode pooler — used by the runtime (pgBouncer, IPv4-only)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session-mode pooler — used by Prisma CLI migrations only (direct, no pgBouncer)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

PRISMA_SLOW_QUERY_MS=500

# pg-pool tuning (applies via driver adapter, not Prisma connection_limit)
DB_CONNECTION_LIMIT=10
DB_IDLE_TIMEOUT_MS=300000
DB_POOL_TIMEOUT=15
DB_KEEPALIVE_MS=240000

# ─── Redis / BullMQ (Upstash) ─────────────────────────────────────────────────
# Use the rediss:// (TLS) URL from your Upstash dashboard
REDIS_URL=rediss://default:<token>@<endpoint>.upstash.io:6379
BULLMQ_PREFIX={nuts}

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Min 32 characters each. JWT_ACCESS_SECRET is also accepted as an alias.
JWT_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nuts
JWT_ACCESS_AUDIENCE=nuts-api
JWT_REFRESH_AUDIENCE=nuts-api

# ─── OTP ──────────────────────────────────────────────────────────────────────
OTP_TTL_MIN=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=60
OTP_PEPPER=change-me-otp-pepper-secret-min-32-chars-long

# ─── Payments (Paystack) ──────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=change-me-paystack-secret-key
PAYSTACK_CALLBACK_URL=https://your-client-tunnel.ngrok-free.app/order-success
PAYSTACK_WEBHOOK_URL=https://your-api-tunnel.ngrok-free.app/api/v1/payments/webhook
DEFAULT_CURRENCY=ngn

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
EMAIL_FROM="NUTS Commerce <no-reply@nuts-commerce.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ─── Cloudinary ───────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=nuts-commerce

# ─── Referrals & Checkout ─────────────────────────────────────────────────────
REFERRAL_DISCOUNT_AMOUNT=500
CHECKOUT_REVALIDATE_PRICES=true

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_SETUP_SECRET=change-me-admin-setup-secret-min-32-chars-long

# ─── Dev Tools ────────────────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SWAGGER_ENABLED=true
