{
  "name": "@nuts/api",
  "version": "0.0.1",
  "description": "NUTS Backend Modular API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});for(const f of fs.readdirSync('.'))if(f.endsWith('.tsbuildinfo'))fs.rmSync(f,{force:true})\"",
    "prebuild": "npm run clean",
    "build": "node ../../node_modules/@typescript/native/lib/tsc.js -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npm run start:prod",
    "predev": "npm run build",
    "dev": "concurrently -k -n tsc,api \"node ../../node_modules/@typescript/native/lib/tsc.js -p tsconfig.build.json --watch --preserveWatchOutput\" \"node scripts/dev-runner.mjs\"",
    "typecheck": "node ../../node_modules/@typescript/native/lib/tsc.js --noEmit",
    "prestart:debug": "npm run build",
    "start:debug": "concurrently -k -n tsc,api \"node ../../node_modules/@typescript/native/lib/tsc.js -p tsconfig.build.json --watch --preserveWatchOutput\" \"cross-env NODE_OPTIONS=--inspect node scripts/dev-runner.mjs\"",
    "start:prod": "cross-env NODE_ENV=production TS_NODE_PROJECT=tsconfig.runtime.json node -r tsconfig-paths/register dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "cross-env NODE_OPTIONS=--inspect-brk jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migrate:deploy": "prisma migrate deploy --schema=../../packages/database/schema.prisma",
    "migrate:status": "prisma migrate status --schema=../../packages/database/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=../../packages/database/schema.prisma",
    "db:generate": "prisma generate --schema=../../packages/database/schema.prisma",
    "docker:dev": "docker compose --profile dev up --build",
    "docker:prod": "docker compose --profile prod up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "start:dev": "npm run dev",
    "start:staging": "cross-env NODE_ENV=staging TS_NODE_PROJECT=tsconfig.runtime.json node -r tsconfig-paths/register dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^6.4.0",
    "@prisma/client": "^6.4.0",
    "@sentry/nestjs": "^11.6.0",
    "@sentry/node": "^11.6.0",
    "@sentry/profiling-node": "^11.6.0",
    "amqplib": "^2.2.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cockatiel": "^4.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "multer": "^2.4.0",
    "nanoid": "^3.3.18",
    "nestjs-pino": "^4.6.1",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.0",
    "pg": "^8.20.0",
    "pino-http": "^11.0.0",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.0",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.0.0",
    "@swc/core": "^1.13.0",
    "@swc/jest": "^0.2.39",
    "@typescript/native": "npm:typescript@^7.0.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prisma": "^6.4.0",
    "supertest": "^7.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transformIgnorePatterns": [
      "node_modules[\\\\/](?!cockatiel[\\\\/])"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest",
        {
          "jsc": {
            "target": "es2022",
            "parser": { "syntax": "typescript", "decorators": true },
            "transform": { "legacyDecorator": true, "decoratorMetadata": true }
          },
          "module": { "type": "commonjs" }
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@api/modules/users/(.*)$": ["<rootDir>/modules/identity/users/$1", "<rootDir>/modules/users/$1"],
      "^@api/modules/creators/(.*)$": ["<rootDir>/modules/identity/creators/$1", "<rootDir>/modules/creators/$1"],
      "^@api/modules/admin/(.*)$": ["<rootDir>/modules/identity/admin/$1", "<rootDir>/modules/admin/$1"],
      "^@api/modules/products/(.*)$": ["<rootDir>/modules/catalog/products/$1", "<rootDir>/modules/products/$1"],
      "^@api/modules/category/(.*)$": ["<rootDir>/modules/catalog/categories/$1", "<rootDir>/modules/catalog/category/$1", "<rootDir>/modules/category/$1"],
      "^@api/modules/product-variants/(.*)$": ["<rootDir>/modules/catalog/variants/$1", "<rootDir>/modules/catalog/product-variants/$1", "<rootDir>/modules/product-variants/$1"],
      "^@api/modules/cart/(.*)$": ["<rootDir>/modules/checkout/cart/$1", "<rootDir>/modules/cart/$1"],
      "^@api/modules/orders/(.*)$": ["<rootDir>/modules/checkout/orders/$1", "<rootDir>/modules/orders/$1"],
      "^@api/modules/promotions/(.*)$": ["<rootDir>/modules/checkout/discounts/$1", "<rootDir>/modules/checkout/promotions/$1", "<rootDir>/modules/promotions/$1"],
      "^@api/modules/payments/(.*)$": ["<rootDir>/modules/billing/payments/$1", "<rootDir>/modules/payments/$1"],
      "^@api/modules/wallet/(.*)$": ["<rootDir>/modules/billing/wallets/$1", "<rootDir>/modules/billing/wallet/$1", "<rootDir>/modules/wallet/$1"],
      "^@api/modules/reviews/(.*)$": ["<rootDir>/modules/engagement/reviews/$1", "<rootDir>/modules/reviews/$1"],
      "^@api/modules/wishlist/(.*)$": ["<rootDir>/modules/engagement/wishlist/$1", "<rootDir>/modules/wishlist/$1"],
      "^@api/modules/referral/(.*)$": ["<rootDir>/modules/engagement/referral/$1", "<rootDir>/modules/referral/$1"],
      "^@api/(.*)$": "<rootDir>/$1"
    }
  }
}
