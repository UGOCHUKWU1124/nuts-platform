# ==============================================================================
# NUTS Commerce - Local Docker Environment Configuration
# ==============================================================================
# To achieve sub-millisecond (< 1ms) database & cache response times during local
# development, spin up Postgres and Redis locally using:
#   npm run docker:db
# Then point your local server (.env) to these localhost endpoints:
# ==============================================================================

# Database (Local Postgres Container)
POSTGRESQL_URL=postgresql://nuts_admin:change-me-local-postgres-password@localhost:5432/nuts?schema=public
DATABASE_URL=postgresql://nuts_admin:change-me-local-postgres-password@localhost:5432/nuts?schema=public
DIRECT_URL=postgresql://nuts_admin:change-me-local-postgres-password@localhost:5432/nuts?schema=public

# Redis (Local Redis Container)
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX={nuts}

# Local-only Postgres credentials. Replace before any shared or production deployment.
POSTGRES_DB=nuts
POSTGRES_USER=nuts_admin
POSTGRES_PASSWORD=change-me-local-postgres-password

# Server
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SAME_SITE=lax

# JWT & Security (local placeholders; replace with unique random values of at least 32 characters)
JWT_SECRET=change-me-jwt-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=nuts
JWT_ACCESS_AUDIENCE=nuts-api
JWT_REFRESH_AUDIENCE=nuts-api
OTP_PEPPER=change-me-otp-pepper-secret-min-32-chars-long
ADMIN_SETUP_SECRET=change-me-admin-setup-secret-min-32-chars-long

# Query Logging
PRISMA_SLOW_QUERY_MS=50
