{
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "paths": {
      "@api/modules/auth/*": ["./src/modules/auth/*"],
      "@api/modules/users/*": ["./src/modules/identity/users/*", "./src/modules/users/*"],
      "@api/modules/creators/*": ["./src/modules/identity/creators/*", "./src/modules/creators/*"],
      "@api/modules/admin/*": ["./src/modules/identity/admin/*", "./src/modules/admin/*"],
      "@api/modules/products/*": ["./src/modules/catalog/products/*", "./src/modules/products/*"],
      "@api/modules/category/*": ["./src/modules/catalog/categories/*", "./src/modules/catalog/category/*", "./src/modules/category/*"],
      "@api/modules/product-variants/*": ["./src/modules/catalog/variants/*", "./src/modules/catalog/product-variants/*", "./src/modules/product-variants/*"],
      "@api/modules/cart/*": ["./src/modules/checkout/cart/*", "./src/modules/cart/*"],
      "@api/modules/orders/*": ["./src/modules/checkout/orders/*", "./src/modules/orders/*"],
      "@api/modules/promotions/*": ["./src/modules/checkout/discounts/*", "./src/modules/checkout/promotions/*", "./src/modules/promotions/*"],
      "@api/modules/payments/*": ["./src/modules/billing/payments/*", "./src/modules/payments/*"],
      "@api/modules/wallet/*": ["./src/modules/billing/wallets/*", "./src/modules/billing/wallet/*", "./src/modules/wallet/*"],
      "@api/modules/reviews/*": ["./src/modules/engagement/reviews/*", "./src/modules/reviews/*"],
      "@api/modules/wishlist/*": ["./src/modules/engagement/wishlist/*", "./src/modules/wishlist/*"],
      "@api/modules/referral/*": ["./src/modules/engagement/referral/*", "./src/modules/referral/*"],
      "@api/modules/*": ["./src/modules/*"],
      "@api/common/*": ["./src/common/*"],
      "@api/*": ["./src/*"]
    },
    "isolatedModules": false,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true,
    "strictPropertyInitialization": false,
    "types": ["jest", "node"]
  },
  "exclude": ["node_modules", "dist"]
}
