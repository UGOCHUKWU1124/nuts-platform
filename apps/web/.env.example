# ==============================================================================
# NUTS Commerce — Web Client Environment Example
# ==============================================================================
# Copy to .env.development or .env.production as needed.
PORT=5173
NODE_ENV=development

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=/api/v1

# Sentry
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ENVIRONMENT=development

# Internal Docker networking
# INTERNAL_API_URL=http://api:3001

# Edge cryptographic token verification secret (matches API JWT_SECRET)
JWT_SECRET=change-me-access-secret-min-32-chars-long
